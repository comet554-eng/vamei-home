# 复制为 .env 后填写。.env 里有密钥，不要提交到 git。
# 不填就是离线模板模式：流程能跑，理解用关键词规则，生成用模板，修改指令不生效。

# mock / openai / anthropic。openai 指任何 OpenAI 兼容接口（大赛提供的统一 API 多半是这种）
HA_LLM_PROVIDER=mock
HA_LLM_API_KEY=
# openai 兼容接口必填；anthropic 不填默认 claude-opus-5-5
HA_LLM_MODEL=
# openai 兼容接口的地址，形如 https://example.com/v1；不填用官方地址
HA_LLM_BASE_URL=
HA_LLM_TIMEOUT=60
